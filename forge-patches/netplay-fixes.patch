@@ -0,0 +1,495 @@
+package forge.net;
+
+import forge.card.CardDb;
+import forge.deck.Deck;
+import forge.game.Game;
+import forge.game.GameView;
+import forge.game.card.Card;
+import forge.game.card.CardView;
+import forge.game.player.Player;
+import forge.game.player.PlayerView;
+import forge.game.zone.ZoneType;
+import forge.gamemodes.match.HostedMatch;
+import forge.gamemodes.match.LobbySlot;
+import forge.gamemodes.match.LobbySlotType;
+import forge.gamemodes.net.client.FGameClient;
+import forge.gamemodes.net.server.FServerManager;
+import forge.gamemodes.net.server.HostingServer;
+import forge.gamemodes.net.server.ServerGameLobby;
+import forge.item.PaperCard;
+import forge.model.FModel;
+import forge.player.PlayerControllerHuman;
+import forge.util.IHasForgeLog;
+import io.netty.channel.Channel;
+import org.testng.annotations.AfterMethod;
+import org.testng.annotations.BeforeClass;
+import org.testng.annotations.Test;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+import java.util.TreeSet;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.testng.Assert.assertNull;
+import static org.testng.Assert.assertTrue;
+
+/**
+ * Unstable connections during real networked games, with remote players kept human
+ * (the stock harness hands them to a server-side AI, so the server never waits on the
+ * network). Remote clients drop at random times and at chosen moments (inside a question
+ * the host is waiting on, or on an input prompt), in several ways, and reconnect.
+ *
+ * <p>Fails on: a stall while everyone is connected, a client that never recovers, a
+ * reconnected client whose view disagrees with the server, or a game that never ends.
+ *
+ * <p>Silent drops need a short server heartbeat; the property is set before the server
+ * class loads, so run this class in its own JVM (otherwise silent drops are skipped).
+ */
+public class NetplayDisconnectChaosTest implements IHasForgeLog {
+
+    static {
+        System.setProperty("forge.net.heartbeatTimeout", "5");
+    }
+
+    private static final long STALL_LIMIT_MS = 25_000;
+    private static final long RECOVERY_LIMIT_MS = 60_000;
+    private static final long GAME_LIMIT_MS = 300_000;
+
+    /**
+     * MID_DECISION: inside a dialog the host blocks on (getChoices, order, ...).
+     * MID_CHOICE: on an input prompt that is a decision (yes/no, discard, ...), not priority.
+     * MID_PROMPT: on a priority prompt.
+     */
+    enum Disruption { ABRUPT, SILENT, RESTART, FLAP, MID_DECISION, MID_CHOICE, MID_PROMPT }
+
+    /** One remote seat: the client currently playing it, and drops armed for the next question/prompt. */
+    static final class Seat {
+        final String name;
+        volatile HeadlessNetworkClient client;
+        final AtomicReference<String> armed = new AtomicReference<>();
+        final AtomicBoolean droppedByHook = new AtomicBoolean();
+        Seat(final String name) { this.name = name; }
+    }
+
+    private final Random random = new Random(20261029);
+    private final Map<Disruption, Integer> performed = new EnumMap<>(Disruption.class);
+    private final List<String> problems = new ArrayList<>();
+    private volatile boolean disrupting;
+    private final java.util.concurrent.atomic.AtomicInteger dialogDropsLeft = new java.util.concurrent.atomic.AtomicInteger();
+    private boolean silentDropsWork;
+
+    @BeforeClass
+    public void init() throws Exception {
+        TestUtils.ensureFModelInitialized();
+        final Field heartbeat = FServerManager.class.getDeclaredField("HEARTBEAT_TIMEOUT_SECONDS");
+        heartbeat.setAccessible(true);
+        silentDropsWork = heartbeat.getInt(null) <= 10;
+        if (!silentDropsWork) {
+            netLog.warn("[Chaos] Server heartbeat is {}s (class loaded earlier in this JVM); silent drops skipped", heartbeat.getInt(null));
+        }
+    }
+
+    @AfterMethod(alwaysRun = true)
+    public void cleanup() {
+        HeadlessNetworkGuiGame.answerHook = null;
+        if (HostingServer.isHosting()) {
+            FServerManager.getInstance().stopServer();
+        }
+    }
+
+    /**
+     * Player vs player vs player: the host plus two remote friends on unstable connections.
+     * The host's own player never crosses the network (it cannot disconnect), so a bot
+     * plays that seat; both friends are remote humans answering over the network.
+     */
+    @Test(timeOut = 1_200_000)
+    public void hostAndTwoFlakyFriends() throws Exception {
+        runChaosSession(2, 20);
+    }
+
+    /** Plays games back to back (each a fresh server and lobby) until enough drops were exercised. */
+    private void runChaosSession(final int remoteCount, final int targetDisruptions) throws Exception {
+        performed.clear();
+        problems.clear();
+        dialogDropsLeft.set(4);
+        HeadlessNetworkClient.thinkTimeMs = 400; // a human pace, so drops land mid-game
+        int total = 0;
+        int games = 0;
+        try {
+            // Keep playing until enough drops, including one inside a blocking dialog (they are rare)
+            while ((total < targetDisruptions || performed.getOrDefault(Disruption.MID_DECISION, 0) == 0) && games < 4) {
+                games++;
+                HeadlessNetworkClient.thinkTimeMs = 400;
+                total += runChaosGame(remoteCount, targetDisruptions - total);
+                if (HostingServer.isHosting()) {
+                    FServerManager.getInstance().stopServer();
+                }
+            }
+        } finally {
+            HeadlessNetworkClient.thinkTimeMs = 0;
+        }
+        netLog.info("[Chaos] Session: {} drops over {} game(s): {}", total, games, performed);
+        assertTrue(total >= targetDisruptions * 3 / 4, "Exercised enough drops (" + total + " in " + games + " games): " + performed);
+        assertTrue(performed.getOrDefault(Disruption.MID_DECISION, 0) > 0,
+                "Dropped at least once while the host was blocked on a dialog: " + performed);
+    }
+
+    /** One game under disruption; returns how many disruptions were applied. */
+    private int runChaosGame(final int remoteCount, final int maxDisruptions) throws Exception {
+        final FServerManager server = FServerManager.getInstance();
+        final int port = PortAllocator.allocatePort();
+        server.startServer(port);
+        final ServerGameLobby lobby = new ServerGameLobby();
+        server.setLobby(lobby);
+        for (int i = 2; i <= remoteCount; i++) {
+            lobby.addSlot();
+        }
+
+        // The AI host attacks and asks the remote players questions over the network
+        // (Vexing Devil: "take 4 damage?"); the remote players never play lands, so their
+        // hands overflow and they must discard at every cleanup.
+        final LobbySlot host = lobby.getSlot(0);
+        host.setType(LobbySlotType.AI);
+        host.setName("ChaosHost");
+        host.setDeck(aggroDeck());
+        host.setIsReady(true);
+        final List<Seat> seats = new ArrayList<>();
+        for (int i = 1; i <= remoteCount; i++) {
+            final LobbySlot slot = lobby.getSlot(i);
+            slot.setType(LobbySlotType.OPEN);
+            slot.setDeck(TestDeckLoader.createMinimalDeck("Plains", 40));
+            slot.setIsReady(false);
+            seats.add(new Seat("Flaky" + i));
+        }
+        Thread.sleep(500);
+
+        for (final Seat seat : seats) {
+            seat.client = new HeadlessNetworkClient(seat.name, "localhost", port);
+            assertTrue(seat.client.connect(15_000), seat.name + " joins");
+            Thread.sleep(800);
+            seat.client.setReady();
+            Thread.sleep(800);
+        }
+        installHook(seats);
+
+        final Runnable start = lobby.startGame();
+        assertTrue(start != null, "Game starts");
+        start.run();
+        for (final Seat seat : seats) {
+            assertTrue(seat.client.waitForGameStart(30_000), seat.name + " receives the game");
+        }
+        final HostedMatch match = HeadlessGuiDesktop.getLastMatch();
+        final Game game = match.getGame();
+
+        final AtomicReference<String> stall = new AtomicReference<>();
+        final Thread monitor = startStallMonitor(game, seats, stall);
+        final long deadline = System.currentTimeMillis() + GAME_LIMIT_MS;
+        int count = 0;
+        try {
+            Thread.sleep(3000); // let the opening (mulligans, first turn) settle
+            while (!game.isGameOver() && count < maxDisruptions && stall.get() == null && System.currentTimeMillis() < deadline) {
+                final Seat seat = seats.get(random.nextInt(seats.size()));
+                if (isEliminated(game, seat)) {
+                    if (seats.stream().allMatch(s -> isEliminated(game, s))) break;
+                    continue;
+                }
+                final Disruption kind = pickDisruption();
+                disrupting = true;
+                final long fullSyncsBefore = seat.client.getFullStateSyncsReceived();
+                final HeadlessNetworkClient before = seat.client;
+                netLog.info("[Chaos] #{} {} on {} (turn {}, {})", count + 1, kind, seat.name,
+                        game.getPhaseHandler().getTurn(), game.getPhaseHandler().getPhase());
+                if (!disrupt(kind, seat, port)) {
+                    disrupting = false;
+                    continue;
+                }
+                synchronized (performed) {
+                    performed.merge(kind, 1, Integer::sum);
+                }
+                count++;
+                awaitRecovery(game, seat, before, fullSyncsBefore, kind);
+                disrupting = false;
+                if (!game.isGameOver() && !isEliminated(game, seat)) {
+                    checkViewMatchesServer(game, seat, kind);
+                }
+                Thread.sleep(800 + random.nextInt(2000));
+            }
+            // Let the game play out at full speed with whatever state the drops left behind
+            HeadlessNetworkClient.thinkTimeMs = 0;
+            while (!game.isGameOver() && stall.get() == null && System.currentTimeMillis() < deadline) {
+                Thread.sleep(500);
+            }
+        } finally {
+            monitor.interrupt();
+            HeadlessNetworkGuiGame.answerHook = null;
+            netLog.info("[Chaos] Performed: {}  problems: {}", performed, problems);
+            for (final Seat seat : seats) {
+                seat.client.close();
+            }
+        }
+        assertNull(stall.get(), "Game stalled: " + stall.get());
+        assertTrue(problems.isEmpty(), "Problems: " + String.join(" | ", problems));
+        assertTrue(game.isGameOver(), "Game finished within " + GAME_LIMIT_MS / 1000 + "s; performed " + performed);
+        return count;
+    }
+
+    // ------------------------------------------------------------------ disruptions
+
+    private Disruption pickDisruption() {
+        while (true) {
+            final int roll = random.nextInt(100);
+            // MID_DECISION is applied by the hook whenever a blocking dialog arrives
+            final Disruption kind = roll < 20 ? Disruption.ABRUPT
+                    : roll < 35 ? Disruption.SILENT
+                    : roll < 47 ? Disruption.RESTART
+                    : roll < 62 ? Disruption.FLAP
+                    : roll < 85 ? Disruption.MID_CHOICE
+                    : Disruption.MID_PROMPT;
+            if (kind != Disruption.SILENT || silentDropsWork) return kind;
+        }
+    }
+
+    /** Returns false if the disruption could not be applied (e.g. no question arrived to drop inside). */
+    private boolean disrupt(final Disruption kind, final Seat seat, final int port) throws Exception {
+        switch (kind) {
+            case ABRUPT -> closeChannel(seat.client);
+            case SILENT -> seat.client.getClient().simulateDisconnect(FGameClient.DisconnectMode.OUTBOUND);
+            case RESTART -> {
+                // The old copy's connection dies silently; a fresh copy logs in under the same name
+                final HeadlessNetworkClient old = seat.client;
+                old.getClient().simulateDisconnect(FGameClient.DisconnectMode.OUTBOUND);
+                Thread.sleep(200);
+                final HeadlessNetworkClient fresh = new HeadlessNetworkClient(seat.name, "localhost", port);
+                fresh.connect(3000); // a resume carries no slot assignment
+                seat.client = fresh;
+                if (!fresh.waitForGameStart(15_000)) {
+                    problems.add("RESTART: " + seat.name + " did not get the seat back");
+                }
+                Thread.sleep(1500);
+                if (old.getClient().getReconnectState() != FGameClient.ReconnectState.SEAT_LOST) {
+                    problems.add("RESTART: replaced copy of " + seat.name + " did not stand down (" + old.getClient().getReconnectState() + ")");
+                }
+                old.close();
+            }
+            case FLAP -> {
+                for (int i = 0; i < 3; i++) {
+                    closeChannel(seat.client);
+                    final long until = System.currentTimeMillis() + 15_000;
+                    Thread.sleep(300);
+                    while (seat.client.getClient().getReconnectState() != FGameClient.ReconnectState.CONNECTED
+                            && System.currentTimeMillis() < until) {
+                        Thread.sleep(100);
+                    }
+                    Thread.sleep(200 + random.nextInt(600));
+                }
+            }
+            case MID_DECISION, MID_CHOICE, MID_PROMPT -> {
+                seat.droppedByHook.set(false);
+                seat.armed.set(kind.name());
+                final long until = System.currentTimeMillis() + 20_000;
+                while (!seat.droppedByHook.get() && System.currentTimeMillis() < until) {
+                    Thread.sleep(50);
+                }
+                seat.armed.set(null);
+                if (!seat.droppedByHook.get()) {
+                    netLog.info("[Chaos] No {} arrived for {} in 20s; skipped", kind, seat.name);
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    /** Drops the connection inside a question or prompt the host is waiting on, before the answer leaves. */
+    private void installHook(final List<Seat> seats) {
+        HeadlessNetworkGuiGame.answerHook = (gui, method) -> {
+            for (final Seat seat : seats) {
+                final HeadlessNetworkClient client = seat.client;
+                if (client == null || client.getGui() != gui) continue;
+                final boolean isPrompt = method.startsWith("prompt:");
+                // Blocking dialogs are rare (a few per game), so drop the first ones whenever they come
+                if (!isPrompt && seat.armed.get() == null && dialogDropsLeft.getAndDecrement() > 0) {
+                    netLog.info("[Chaos] Dropping {} inside dialog {} (host is blocked on the answer)", seat.name, method);
+                    synchronized (performed) {
+                        performed.merge(Disruption.MID_DECISION, 1, Integer::sum);
+                    }
+                    closeChannel(client);
+                    return;
+                }
+                final String want = seat.armed.get();
+                if (want == null) return;
+                if (isPrompt && method.contains("Waiting")) return; // not a decision of ours
+                final boolean isPriority = isPrompt && method.startsWith("prompt: Priority");
+                final boolean matches = switch (Disruption.valueOf(want)) {
+                    case MID_DECISION -> !isPrompt;
+                    case MID_CHOICE -> isPrompt && !isPriority;
+                    default -> isPriority;
+                };
+                if (!matches) return;
+                if (seat.armed.compareAndSet(want, null)) {
+                    netLog.info("[Chaos] Dropping {} inside {}", seat.name, method);
+                    closeChannel(client);
+                    seat.droppedByHook.set(true);
+                }
+                return;
+            }
+        };
+    }
+
+    private static void closeChannel(final HeadlessNetworkClient client) {
+        try {
+            final Field field = FGameClient.class.getDeclaredField("channel");
+            field.setAccessible(true);
+            final Channel channel = (Channel) field.get(client.getClient());
+            if (channel != null) {
+                channel.close();
+            }
+        } catch (final ReflectiveOperationException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    // ------------------------------------------------------------------ checks
+
+    private void awaitRecovery(final Game game, final Seat seat, final HeadlessNetworkClient before,
+                               final long fullSyncsBefore, final Disruption kind) throws InterruptedException {
+        final long until = System.currentTimeMillis() + RECOVERY_LIMIT_MS;
+        while (System.currentTimeMillis() < until && !game.isGameOver()) {
+            final HeadlessNetworkClient now = seat.client;
+            final boolean resynced = now != before || now.getFullStateSyncsReceived() > fullSyncsBefore;
+            if (resynced && now.getClient().getReconnectState() == FGameClient.ReconnectState.CONNECTED) {
+                return;
+            }
+            Thread.sleep(100);
+        }
+        if (!game.isGameOver()) {
+            problems.add(kind + ": " + seat.name + " did not recover within " + RECOVERY_LIMIT_MS / 1000
+                    + "s (client state " + seat.client.getClient().getReconnectState() + ")");
+        }
+    }
+
+    /** The reconnected client's view converges to the server's game within a few seconds. */
+    private void checkViewMatchesServer(final Game game, final Seat seat, final Disruption kind) throws InterruptedException {
+        String last = null;
+        final long until = System.currentTimeMillis() + 8000;
+        while (System.currentTimeMillis() < until && !game.isGameOver()) {
+            last = compare(game, seat.client.getGameView());
+            if (last == null) return;
+            Thread.sleep(250);
+        }
+        if (last != null && !game.isGameOver()) {
+            problems.add("after " + kind + " on " + seat.name + ": " + last);
+        }
+    }
+
+    private static String compare(final Game game, final GameView view) {
+        if (view == null) return "client has no game view";
+        if (view.getPlayers() == null) return "client view has no players yet"; // mid-resync; retried
+        for (final Player p : game.getRegisteredPlayers()) {
+            PlayerView pv = null;
+            for (final PlayerView candidate : view.getPlayers()) {
+                if (candidate.getName().equals(p.getName())) pv = candidate;
+            }
+            if (pv == null) return "client is missing player " + p.getName();
+            if (pv.getLife() != p.getLife()) return p.getName() + " life: client " + pv.getLife() + " server " + p.getLife();
+            for (final ZoneType zone : new ZoneType[] {ZoneType.Hand, ZoneType.Library, ZoneType.Graveyard, ZoneType.Exile}) {
+                if (pv.getZoneSize(zone) != p.getZone(zone).size()) {
+                    return p.getName() + " " + zone + ": client " + pv.getZoneSize(zone) + " server " + p.getZone(zone).size();
+                }
+            }
+            final TreeSet<Integer> serverField = new TreeSet<>();
+            for (final Card c : p.getCardsIn(ZoneType.Battlefield)) serverField.add(c.getId());
+            final TreeSet<Integer> clientField = new TreeSet<>();
+            if (pv.getCards(ZoneType.Battlefield) != null) {
+                for (final CardView c : pv.getCards(ZoneType.Battlefield)) clientField.add(c.getId());
+            }
+            if (!serverField.equals(clientField)) {
+                return p.getName() + " battlefield: client " + clientField + " server " + serverField;
+            }
+        }
+        return null;
+    }
+
+    /** Flags a game that stops changing while no disruption is in progress. */
+    private Thread startStallMonitor(final Game game, final List<Seat> seats, final AtomicReference<String> stall) {
+        final Thread monitor = new Thread(() -> {
+            String signature = "";
+            long changed = System.currentTimeMillis();
+            try {
+                while (!game.isGameOver() && stall.get() == null) {
+                    Thread.sleep(500);
+                    final String now = signature(game);
+                    if (!now.equals(signature) || disrupting) {
+                        signature = now;
+                        changed = System.currentTimeMillis();
+                    } else if (System.currentTimeMillis() - changed > STALL_LIMIT_MS) {
+                        stall.set("no progress for " + STALL_LIMIT_MS / 1000 + "s at " + now + "; " + inputs(game, seats));
+                    }
+                }
+            } catch (final InterruptedException ignored) {
+                // test finished
+            }
+        }, "chaos-stall-monitor");
+        monitor.setDaemon(true);
+        monitor.start();
+        return monitor;
+    }
+
+    private static String signature(final Game game) {
+        final StringBuilder sb = new StringBuilder();
+        sb.append("turn ").append(game.getPhaseHandler().getTurn()).append(' ').append(game.getPhaseHandler().getPhase())
+                .append(" stack ").append(game.getStack().size());
+        for (final Player p : game.getRegisteredPlayers()) {
+            sb.append(" | ").append(p.getName()).append(" life ").append(p.getLife())
+                    .append(" hand ").append(p.getZone(ZoneType.Hand).size())
+                    .append(" lib ").append(p.getZone(ZoneType.Library).size())
+                    .append(" bf ").append(p.getZone(ZoneType.Battlefield).size());
+        }
+        return sb.toString();
+    }
+
+    private static String inputs(final Game game, final List<Seat> seats) {
+        final StringBuilder sb = new StringBuilder();
+        for (final Player p : game.getRegisteredPlayers()) {
+            if (p.getController() instanceof PlayerControllerHuman human) {
+                final Object input = human.getInputQueue().getInput();
+                sb.append(p.getName()).append(" input=").append(input == null ? "none" : input.getClass().getSimpleName()).append("; ");
+            }
+        }
+        for (final Seat seat : seats) {
+            sb.append(seat.name).append(" client=").append(seat.client.getClient().getReconnectState()).append("; ");
+        }
+        return sb.toString();
+    }
+
+    private static boolean isEliminated(final Game game, final Seat seat) {
+        for (final Player p : game.getRegisteredPlayers()) {
+            if (p.getName().equals(seat.name)) return p.hasLost();
+        }
+        return true;
+    }
+
+    private static Deck aggroDeck() {
+        final CardDb db = FModel.getMagicDb().getCommonCards();
+        final Deck deck = new Deck("Chaos aggro");
+        // Cards that ask the opponent something: Vexing Devil (yes/no prompt) and
+        // Fact or Fiction (the opponent splits the piles); goblins end the game.
+        add(deck, db, "Mountain", 12);
+        add(deck, db, "Island", 10);
+        add(deck, db, "Vexing Devil", 8);
+        add(deck, db, "Fact or Fiction", 4);
+        add(deck, db, "Raging Goblin", 6);
+        return deck;
+    }
+
+    private static void add(final Deck deck, final CardDb db, final String name, final int count) {
+        final PaperCard card = db.getCard(name);
+        if (card == null) throw new IllegalStateException("Card not found: " + name);
+        for (int i = 0; i < count; i++) deck.getMain().add(card);
+    }
+}
diff --git a/forge-gui-desktop/src/test/java/forge/net/NetplaySeatReclaimTest.java b/forge-gui-desktop/src/test/java/forge/net/NetplaySeatReclaimTest.java
