--- /dev/null
+++ b/forge-gui-desktop/src/test/java/forge/net/embedded/StaleSelectionResyncTest.java
@@ -0,0 +1,94 @@
+package forge.net.embedded;
+
+import forge.game.GameType;
+import forge.game.GameView;
+import forge.game.card.CardView;
+import forge.game.phase.PhaseType;
+import forge.game.player.PlayerView;
+import forge.game.player.RegisteredPlayer;
+import forge.gamemodes.match.HostedMatch;
+import forge.gamemodes.net.ProtocolGuiGame;
+import forge.gamemodes.net.event.GuiGameEvent;
+import forge.gui.FThreads;
+import forge.interfaces.IGameController;
+import forge.localinstance.properties.ForgePreferences.FPref;
+import forge.model.FModel;
+import forge.net.TestDeckLoader;
+import forge.net.TestUtils;
+import forge.player.GamePlayerUtil;
+import forge.player.LobbyPlayerHuman;
+import org.testng.annotations.Test;
+
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+import static org.testng.Assert.assertEquals;
+import static org.testng.Assert.assertTrue;
+
+/**
+ * ForgeUI netplay fix: a remote player who clicks a card the game no longer has (their
+ * view went stale, e.g. after a reconnect) gets a fresh full state, instead of every
+ * click being silently dropped while they cannot act (the 10-19 "can't block" case).
+ */
+public class StaleSelectionResyncTest {
+
+    @Test(timeOut = 120_000)
+    public void clickOnMissingCardRefreshesThePlayersView() throws Exception {
+        TestUtils.ensureFModelInitialized();
+        FModel.getPreferences().setPref(FPref.UI_SHOW_ACTIONABLE_HIGHLIGHTS, false);
+        FModel.getPreferences().setPref(FPref.UI_RECORD_REPLAYS, false);
+
+        final ProtocolGuiGameInProcessTest.RecordingRemote remote = new ProtocolGuiGameInProcessTest.RecordingRemote();
+        final ProtocolGuiGame gui = new ProtocolGuiGame(remote);
+        final RegisteredPlayer human = new RegisteredPlayer(TestDeckLoader.createMinimalDeck("Forest", 40))
+                .setPlayer(new LobbyPlayerHuman("Stale"));
+        final RegisteredPlayer ai = new RegisteredPlayer(TestDeckLoader.createMinimalDeck("Plains", 40))
+                .setPlayer(GamePlayerUtil.createAiPlayer("AI"));
+        final HostedMatch match = new HostedMatch();
+        match.startMatch(GameType.Constructed, null, List.of(human, ai), human, gui);
+
+        int fullStatesBefore = -1;
+        int fullStatesAfterFirst = -1;
+        final long deadline = System.currentTimeMillis() + 90_000;
+        while (System.currentTimeMillis() < deadline) {
+            final GuiGameEvent prompt = remote.buttonPrompts.poll(5, TimeUnit.SECONDS);
+            if (prompt == null) {
+                continue;
+            }
+            final PlayerView owner = (PlayerView) prompt.getObjects()[0];
+            if (remote.myPlayers == null || owner == null || !remote.myPlayers.contains(owner)) {
+                continue;
+            }
+            final IGameController controller = gui.getGameController(owner);
+            final GameView gv = gui.getGameView();
+            final boolean myMain = owner.equals(gv.getPlayerTurn()) && gv.getPhase() == PhaseType.MAIN1;
+            if (myMain && fullStatesBefore < 0) {
+                // A card id the game never had, as a stale client view would send
+                final CardView ghost = new CardView(987_654, gv.getTracker());
+                fullStatesBefore = remote.fullStates;
+                FThreads.invokeInEdtLater(() -> controller.selectCard(ghost, null, null));
+                final long wait = System.currentTimeMillis() + 5000;
+                while (remote.fullStates == fullStatesBefore && System.currentTimeMillis() < wait) {
+                    Thread.sleep(50);
+                }
+                fullStatesAfterFirst = remote.fullStates;
+                // A burst of the same stale clicks is refreshed once, not once per click
+                for (int i = 0; i < 3; i++) {
+                    FThreads.invokeInEdtLater(() -> controller.selectCard(ghost, null, null));
+                }
+                Thread.sleep(500);
+                assertEquals(remote.fullStates, fullStatesAfterFirst, "Repeated stale clicks within the window resend nothing");
+                FThreads.invokeInEdtLater(controller::concede);
+                break;
+            }
+            FThreads.invokeInEdtLater(controller::selectButtonOk);
+        }
+
+        final long end = System.currentTimeMillis() + 30_000;
+        while (match.getGameView() != null && !match.getGameView().isGameOver() && System.currentTimeMillis() < end) {
+            Thread.sleep(100);
+        }
+        assertTrue(fullStatesBefore >= 0, "Reached the player's main phase");
+        assertEquals(fullStatesAfterFirst, fullStatesBefore + 1, "A click on a missing card sends the player one full state");
+    }
+}
