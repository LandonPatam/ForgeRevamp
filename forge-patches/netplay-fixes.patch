+package forge.gamemodes.net;
+
+import forge.gamemodes.net.event.IdentifiableNetEvent;
+import forge.gamemodes.net.event.NetEvent;
+import forge.gamemodes.net.event.SeatLostEvent;
+import forge.gui.interfaces.IGuiGame;
+import forge.net.TestUtils;
+import io.netty.handler.codec.serialization.ClassResolvers;
+import org.testng.annotations.BeforeClass;
+import org.testng.annotations.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import java.util.function.Function;
+
+import static org.testng.Assert.assertEquals;
+import static org.testng.Assert.assertFalse;
+import static org.testng.Assert.assertNotNull;
+import static org.testng.Assert.assertNull;
+import static org.testng.Assert.assertSame;
+import static org.testng.Assert.assertTrue;
+
+/**
+ * ForgeUI netplay fixes: a disconnect never answers a pending question. The question
+ * waits for the reconnect resync and is asked again, or takes a safe default once the
+ * player is abandoned (AI takeover, server stop).
+ */
+public class NetplayResilienceTest {
+
+    /** Answers each question from a script; a script step may act on the GUI first (e.g. pause it). */
+    static final class ScriptedRemote implements IRemote {
+        final List<Function<Integer, Object>> script = Collections.synchronizedList(new ArrayList<>());
+        final List<Long> askedAtMs = Collections.synchronizedList(new ArrayList<>());
+
+        @Override public void send(final NetEvent event) { }
+
+        @Override
+        public Object sendAndWait(final IdentifiableNetEvent event) {
+            askedAtMs.add(System.currentTimeMillis());
+            final int index = askedAtMs.size() - 1;
+            return script.get(Math.min(index, script.size() - 1)).apply(index);
+        }
+    }
+
+    @BeforeClass
+    public void init() {
+        TestUtils.ensureFModelInitialized();
+    }
+
+    @Test
+    public void replyPoolKeepsDisconnectDistinctFromNull() {
+        final ReplyPool pool = new ReplyPool();
+        pool.initialize(1);
+        pool.abortForDisconnect();
+        assertSame(pool.get(1), ReplyPool.DISCONNECTED);
+
+        pool.initialize(2);
+        pool.cancelAll();
+        assertNull(pool.get(2), "AFK cancel still answers null (a pass)");
+    }
+
+    @Test(timeOut = 5000)
+    public void timedReplyWaitGivesUp() {
+        final ReplyPool pool = new ReplyPool();
+        pool.initialize(7);
+        final long start = System.currentTimeMillis();
+        assertNull(pool.get(7, 100));
+        assertTrue(System.currentTimeMillis() - start < 2000);
+    }
+
+    @Test(timeOut = 10000)
+    public void questionDroppedByDisconnectIsAskedAgainAfterResync() throws Exception {
+        final ScriptedRemote remote = new ScriptedRemote();
+        final ProtocolGuiGame gui = new ProtocolGuiGame(remote);
+        // First ask: the connection drops (the server pauses this GUI, then releases the wait).
+        remote.script.add(i -> { gui.pause(); return ReplyPool.DISCONNECTED; });
+        // Second ask, after the reconnect: the player answers "no", against the default of "yes".
+        remote.script.add(i -> Boolean.FALSE);
+
+        final CompletableFuture<Boolean> answer = CompletableFuture.supplyAsync(
+                () -> gui.showConfirmDialog("Keep?", "Test", "Yes", "No", true));
+        Thread.sleep(400);
+        assertFalse(answer.isDone(), "A disconnected player's question must wait, not take the default");
+        assertEquals(remote.askedAtMs.size(), 1);
+
+        gui.resume();
+        Thread.sleep(300);
+        assertFalse(answer.isDone(), "The question must wait for the resync, not just the resume");
+        final long resynced = System.currentTimeMillis();
+        gui.notifyResynced();
+
+        assertEquals(answer.get(5, TimeUnit.SECONDS), Boolean.FALSE, "The reconnected player's real answer is used");
+        assertEquals(remote.askedAtMs.size(), 2);
+        assertTrue(remote.askedAtMs.get(1) >= resynced, "Asked again only after the resync");
+    }
+
+    @Test(timeOut = 10000)
+    public void abandonedQuestionsTakeSafeDefaults() throws Exception {
+        final ScriptedRemote remote = new ScriptedRemote();
+        final ProtocolGuiGame gui = new ProtocolGuiGame(remote);
+        remote.script.add(i -> { gui.pause(); return ReplyPool.DISCONNECTED; });
+
+        // Ordering used to crash the game thread: IGuiGame.order(...).ordered() on a null result.
+        final List<String> source = List.of("a", "b", "c");
+        final CompletableFuture<List<String>> ordered = CompletableFuture.supplyAsync(
+                () -> ((IGuiGame) gui).order("Order", "Top", source, null));
+        Thread.sleep(300);
+        assertFalse(ordered.isDone());
+        gui.abandon();
+        assertEquals(ordered.get(5, TimeUnit.SECONDS), source, "AI takeover keeps the given order");
+
+        // Once abandoned, further questions answer at once with defaults, never null.
+        assertEquals(gui.getChoices("Pick", 2, 2, List.of(1, 2, 3), null, null), List.of(1, 2));
+        assertEquals(gui.getChoices("Pick", 0, 1, List.of(1, 2, 3), null, null), List.of());
+        assertEquals(gui.manipulateCardList("Arrange", List.of(), List.of(), true, true, false), List.of());
+        assertTrue(gui.showConfirmDialog("Q", "T", "Y", "N", true));
+
+        final Map<Object, Integer> targets = new LinkedHashMap<>();
+        targets.put("first", 5);
+        targets.put("second", 5);
+        targets.put("third", 5);
+        final Map<Object, Integer> split = gui.assignGenericAmount(null, targets, 5, true, "damage");
+        assertNotNull(split);
+        assertEquals(split.values().stream().mapToInt(Integer::intValue).sum(), 5);
+        assertTrue(split.values().stream().allMatch(v -> v >= 1), "Every recipient gets at least one");
+        assertEquals(remote.askedAtMs.size(), 1, "Abandoned questions are not sent");
+    }
+
+    @Test
+    public void seatStillHeldSurvivesTheWire() throws Exception {
+        // The real codec streams, so the class filter applies as it would between peers
+        final ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        try (CObjectOutputStream out = new CObjectOutputStream(bytes, false, null, -1, false)) {
+            out.writeObject(new SeatLostEvent(true));
+        }
+        try (CObjectInputStream in = new CObjectInputStream(
+                new ByteArrayInputStream(bytes.toByteArray()), ClassResolvers.cacheDisabled(null), null)) {
+            final SeatLostEvent event = (SeatLostEvent) in.readObject();
+            assertTrue(event.isSeatStillHeld());
+        }
+        assertFalse(new SeatLostEvent().isSeatStillHeld());
+    }
+}
