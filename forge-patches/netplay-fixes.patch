@@ -0,0 +1,87 @@
+package forge.net;
+
+import forge.deck.Deck;
+import forge.gamemodes.match.LobbySlot;
+import forge.gamemodes.match.LobbySlotType;
+import forge.gamemodes.net.client.FGameClient;
+import forge.gamemodes.net.server.FServerManager;
+import forge.gamemodes.net.server.ServerGameLobby;
+import forge.util.IHasForgeLog;
+import org.testng.annotations.BeforeClass;
+import org.testng.annotations.Test;
+
+import static org.testng.Assert.assertEquals;
+import static org.testng.Assert.assertTrue;
+
+/**
+ * ForgeUI netplay fix: a player whose connection died silently (the server has not yet
+ * timed it out) reconnects from the same address and gets their seat back immediately,
+ * instead of being refused with "seat unavailable" until the AI takes over.
+ */
+public class NetplaySeatReclaimTest implements IHasForgeLog {
+
+    @BeforeClass
+    public void init() {
+        TestUtils.ensureFModelInitialized();
+    }
+
+    @Test(timeOut = 120000)
+    public void reconnectReclaimsSeatHeldBySilentConnection() throws Exception {
+        final FServerManager server = FServerManager.getInstance();
+        final int port = PortAllocator.allocatePort();
+        HeadlessNetworkClient first = null;
+        HeadlessNetworkClient second = null;
+        try {
+            server.startServer(port);
+            final ServerGameLobby lobby = new ServerGameLobby();
+            server.setLobby(lobby);
+
+            // A long game, so the match is still running when the player comes back
+            final Deck hostDeck = TestDeckLoader.createMinimalDeck("Mountain", 60);
+            final Deck remoteDeck = TestDeckLoader.createMinimalDeck("Forest", 60);
+            final LobbySlot host = lobby.getSlot(0);
+            host.setType(LobbySlotType.AI);
+            host.setName("Host");
+            host.setDeck(hostDeck);
+            host.setIsReady(true);
+            final LobbySlot remote = lobby.getSlot(1);
+            remote.setType(LobbySlotType.OPEN);
+            remote.setDeck(remoteDeck);
+            remote.setIsReady(false);
+            Thread.sleep(500);
+
+            first = new HeadlessNetworkClient("Rejoiner", "localhost", port);
+            assertTrue(first.connect(15000), "First connection joins the lobby");
+            Thread.sleep(500);
+            first.setReady();
+            Thread.sleep(1000);
+
+            final Runnable start = lobby.startGame();
+            assertTrue(start != null, "Game starts");
+            start.run();
+            assertTrue(first.waitForGameStart(30000), "First connection receives the game");
+
+            // The connection goes silent but stays open: the server still thinks it is
+            // alive for up to the 45s heartbeat timeout (the 10-21 "seat unavailable" case).
+            first.getClient().simulateDisconnect(FGameClient.DisconnectMode.OUTBOUND);
+            Thread.sleep(500);
+
+            second = new HeadlessNetworkClient("Rejoiner", "localhost", port);
+            second.connect(3000); // a resume carries no new slot assignment; wait on the game state instead
+            assertTrue(second.waitForGameStart(15000),
+                    "The new connection takes the seat back well before the server's 45s heartbeat timeout");
+
+            // The replaced connection must stand down, not reconnect and take the seat back.
+            Thread.sleep(4000);
+            assertEquals(first.getClient().getReconnectState(), FGameClient.ReconnectState.SEAT_LOST,
+                    "The replaced connection stops instead of reconnecting");
+            assertEquals(second.getClient().getReconnectState(), FGameClient.ReconnectState.CONNECTED,
+                    "The reclaiming connection keeps the seat");
+            netLog.info("Seat reclaimed; game in progress for the new connection");
+        } finally {
+            if (second != null) second.close();
+            if (first != null) first.close();
+            if (forge.gamemodes.net.server.HostingServer.isHosting()) server.stopServer();
+        }
+    }
+}
diff --git a/forge-gui-desktop/src/test/java/forge/net/embedded/StaleSelectionResyncTest.java b/forge-gui-desktop/src/test/java/forge/net/embedded/StaleSelectionResyncTest.java
